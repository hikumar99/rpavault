---
permalink: /feed.xml
eleventyExcludeFromCollections: true
metadata:
  title: "RPAVault Blog"
  description: "Practical guides on RPA, UiPath, Power BI, SQL, AI agents, and enterprise automation — from the RPAVault team."
  language: "en"
  url: "https://rpavault.com"
  author:
    name: "RPAVault"
    email: "info@rpavault.com"
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ metadata.title }}</title>
    <link>{{ metadata.url }}/blog/</link>
    <atom:link href="{{ metadata.url }}{{ permalink }}" rel="self" type="application/rss+xml" />
    <description>{{ metadata.description }}</description>
    <language>{{ metadata.language }}</language>
    {%- if collections.blogPosts.length > 0 %}
    <lastBuildDate>{{ collections.blogPosts | getNewestCollectionItemDate | dateToRfc822 }}</lastBuildDate>
    {%- endif %}
    {%- for post in collections.blogPosts %}
    {%- set absolutePostUrl %}{{ metadata.url }}{{ post.url }}{% endset %}
    <item>
      <title><![CDATA[{{ post.data.title }}]]></title>
      <link>{{ absolutePostUrl }}</link>
      <guid isPermaLink="true">{{ absolutePostUrl }}</guid>
      <pubDate>{{ post.date | dateToRfc822 }}</pubDate>
      <dc:creator><![CDATA[{{ post.data.author | default(metadata.author.name) }}]]></dc:creator>
      <description><![CDATA[{{ post.data.description | default(post.content | stripHtml | truncate(250)) }}]]></description>
      {%- if post.content %}
      <content:encoded><![CDATA[{{ post.content | htmlToAbsoluteUrls(metadata.url) | safe }}]]></content:encoded>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
