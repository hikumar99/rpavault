---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in collections.all %}
  {%- set absoluteUrl %}https://rpavault.com{{ page.url | url }}{% endset %}
  {%- if page.url and page.url != '/404.html' and page.url != '/search/' and page.url != '/go/' and page.url.indexOf('/admin/') == -1 and not page.data.draft %}
  <url>
    <loc>{{ absoluteUrl }}</loc>
    <lastmod>{{ page.date.toISOString() }}</lastmod>
  </url>
  {%- endif %}
{%- endfor %}
</urlset>
